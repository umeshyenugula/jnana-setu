# Application
APP_ENV=development
PORT=8080
API_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Supabase managed PostgreSQL/pgvector. These are server-side API values only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
# Auth JWT verification (HS256 secret or JWKS via SUPABASE_URL) and expected claims.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated

# Module 2 knowledge management (server-side only; never expose service key to browser).
KNOWLEDGE_STORAGE_BUCKET=knowledge-originals
KNOWLEDGE_MAX_UPLOAD_MB=10

# Module 3 document processing & local embeddings (server-side only).
EMBEDDING_WORKER_URL=http://127.0.0.1:8082
EMBEDDING_MODEL_DIR=./models/all-MiniLM-L6-v2
PROCESSING_WORKERS=2
PROCESSING_RELAY_INTERVAL_S=10
CHUNK_TARGET_TOKENS=200
CHUNK_OVERLAP_TOKENS=35

# Module 4 retrieval engine (internal service-to-service only).
INTERNAL_SERVICE_TOKEN=
RETRIEVAL_TOP_K=5
RETRIEVAL_MAX_TOP_K=20
RETRIEVAL_MIN_SIMILARITY=0.1
RETRIEVAL_MAX_EVIDENCE_TOKENS=4000
RETRIEVAL_EMBED_TIMEOUT_S=30

# Module 6 chat orchestration (public widget endpoint).
CHAT_MAX_MESSAGE_CHARS=2000
CHAT_HISTORY_LIMIT=10
CHAT_TOP_K=5
CHAT_MAX_PROMPT_CHARS=8000
CHAT_FALLBACK_TEXT=
CHAT_RETENTION_DAYS=90
CHAT_RATE_LIMIT_PER_MIN=30

# Module 8 observability and operations.
OBS_LOG_LEVEL=info
OBS_HEALTH_TIMEOUT_S=5
OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4318
OTEL_SAMPLE_RATIO=0.1

# Self-hosted llama.cpp runtime (Module 5 local inference, never public).
LLAMA_CPP_BASE_URL=http://localhost:8081
LLM_MODEL=qwen3-4b
LLM_MODEL_FILE=qwen3-4b-Q4_K_M.gguf
LLM_CONTEXT_WINDOW=4096
LLM_MAX_OUTPUT_TOKENS=512
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9
LLM_REQUEST_TIMEOUT_S=120
LLM_MAX_CONCURRENT=1
LLM_ENABLE_THINKING=false
LLM_MAX_PROMPT_CHARS=12000

# Self-hosted local embedding runtime/model metadata.
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_RUNTIME=local
